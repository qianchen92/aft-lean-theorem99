import CurrentAFT.BinaryProposalMetadata
import CurrentAFT.BinaryBodyProgram
import CurrentAFT.BinaryProfileTables
import AFT.ScalarCompilationResources

/-! # Binary evaluation of the actual primary balancing formula

Every security-dependent input is generated by the local programs.  The
remaining scalar syntax is fixed and has only the literals one and two.
-/
namespace CurrentAFT.BinaryPrimaryRaw
open AFT RationalNumerics BinaryArithmetic BinaryArithmetic.RationalBits RationalRejectionProgram
set_option maxHeartbeats 1800000
set_option maxRecDepth 4096
set_option backward.isDefEq.respectTransparency false

inductive Leaf where
  | colors | legs | population | activation | bodyZero | bodyOne | diffuse
  deriving DecidableEq

structure Cache where
  metadata : BinaryProposalMetadata.Encoded
  activation : RationalBits
  bodyZero : RationalBits
  bodyOne : RationalBits
  diffuse : RationalBits
  work : ℕ

def cache (security bits : ℕ) (output : List Bool) : Cache :=
  let metadata := BinaryProposalMetadata.current security
  let activation := BinaryActivationProgram.current security bits
  let bodyZero := BinaryBodyProgram.current security bits false output
  let bodyOne := BinaryBodyProgram.current security bits true output
  let diffuse := BinaryProfileTables.diffuse security bits output
  ⟨metadata, activation.data, bodyZero.data, bodyOne.data, diffuse.data,
    metadata.work+activation.work+bodyZero.work+bodyOne.work+diffuse.work+5⟩

def Cache.entry (data : Cache) : Leaf → RationalBits
  | .colors => data.metadata.colors
  | .legs => data.metadata.legs
  | .population => data.metadata.population
  | .activation => data.activation
  | .bodyZero => data.bodyZero
  | .bodyOne => data.bodyOne
  | .diffuse => data.diffuse

def Cache.read (data : Cache) (leaf : Leaf) : CountedValue RationalBits :=
  let result := RationalBits.copy (data.entry leaf)
  ⟨result.data, result.work+1⟩

def expression : ScalarProgram Leaf :=
  let q : ScalarProgram Leaf := .atom .colors
  let legs : ScalarProgram Leaf := .atom .legs
  let population : ScalarProgram Leaf := .atom .population
  let rate : ScalarProgram Leaf := .atom .activation
  let two : ScalarProgram Leaf := .rational 2
  let one : ScalarProgram Leaf := .rational 1
  let free := .add (.add population (.negate legs)) (.negate q)
  let marked := .multiply legs rate
  let uniform := .multiply (.add population (.multiply two legs)) (.inverse q)
  let bodyZero := .multiply (.add free marked) (.atom .bodyZero)
  let bodyOne := .multiply (.add legs q) (.atom .bodyOne)
  let diffuse := .multiply (.multiply (.multiply two legs) (.add one (.negate rate))) (.atom .diffuse)
  .multiply (.add (.add (.add uniform (.negate bodyZero)) (.negate bodyOne)) (.negate diffuse)) (.inverse marked)

theorem expression_literals : expression.LiteralBound 2 := by
  norm_num [expression, ScalarProgram.LiteralBound, RationalLiteralBound]

theorem expression_value (leaf : Leaf → ℚ) :
    expression.run leaf =
      ((leaf .population+2*leaf .legs)/leaf .colors-
        (leaf .population-leaf .legs-leaf .colors+leaf .legs*leaf .activation)*leaf .bodyZero-
        (leaf .legs+leaf .colors)*leaf .bodyOne-
        2*leaf .legs*(1-leaf .activation)*leaf .diffuse)/(leaf .legs*leaf .activation) := by
  simp only [expression, ScalarProgram.run, sub_eq_add_neg, div_eq_mul_inv]

def current (security bits : ℕ) (output : List Bool) : RationalResult :=
  let data := cache security bits output
  let result := expression.compileBinaryRun data.read
  ⟨result.value, data.work+result.work+2⟩

theorem current_value (security bits : ℕ) (output : List Bool) :
    (current security bits output).data.decode = RationalProposalProgram.primaryRaw security bits (value output) := by
  rcases BinaryProposalMetadata.current_value security with ⟨hq, hl, hp⟩
  unfold current
  rw [ScalarProgram.compileBinaryRun_value, expression_value]
  simp only [Cache.read, RationalBits.copy_value, Cache.entry, cache,
    BinaryActivationProgram.current_value, BinaryBodyProgram.current_value,
    BinaryProfileTables.diffuse_value, hq, hl, hp]
  unfold RationalProposalProgram.primaryRaw
  rw [PublicParameterProgram.modulus_value]
  push_cast
  rfl

noncomputable section

noncomputable def leafHeightPolynomial (precision inputBits : Polynomial ℕ) : Polynomial ℕ :=
  BinaryProposalMetadata.sizePolynomial+BinaryActivationProgram.currentHeightPolynomial precision+
    BinaryBodyProgram.currentHeightPolynomial precision inputBits+
    BinaryProfileTables.diffuseHeightPolynomial precision inputBits+1

noncomputable def cacheWorkPolynomial (precision inputBits : Polynomial ℕ) : Polynomial ℕ :=
  BinaryProposalMetadata.currentWorkPolynomial+BinaryActivationProgram.currentWorkPolynomial precision+
    2*BinaryBodyProgram.currentWorkPolynomial precision inputBits+
    BinaryProfileTables.diffuseWorkPolynomial precision inputBits+5

noncomputable def currentHeightPolynomial (precision inputBits : Polynomial ℕ) : Polynomial ℕ :=
  Polynomial.C expression.nodes*(leafHeightPolynomial precision inputBits+5)

noncomputable def currentWorkPolynomial (precision inputBits : Polynomial ℕ) : Polynomial ℕ :=
  cacheWorkPolynomial precision inputBits+
    ScalarProgram.compilationWorkPolynomial (Polynomial.C expression.nodes) 2
      (leafHeightPolynomial precision inputBits) (4*leafHeightPolynomial precision inputBits+9)+2

theorem cache_bounds (security : ℕ) (output : List Bool) (precision inputBits : Polynomial ℕ)
    (ho : output.length ≤ inputBits.eval security) :
    (∀ leaf, HeightBound ((cache security (precision.eval security) output).entry leaf).decode
      ((leafHeightPolynomial precision inputBits).eval security)) ∧
    (cache security (precision.eval security) output).work ≤ (cacheWorkPolynomial precision inputBits).eval security := by
  let sizes := BinaryProposalMetadata.current security
  let activation := BinaryActivationProgram.current security (precision.eval security)
  let zero := BinaryBodyProgram.current security (precision.eval security) false output
  let one := BinaryBodyProgram.current security (precision.eval security) true output
  let diffuse := BinaryProfileTables.diffuse security (precision.eval security) output
  have hs := BinaryProposalMetadata.current_height security
  have ha := (BinaryActivationProgram.current_bounds security (precision.eval security)).1
  rw [← BinaryActivationProgram.currentHeightPolynomial_eval precision security] at ha
  have hz := BinaryBodyProgram.current_height security false output precision inputBits ho
  have ho' := BinaryBodyProgram.current_height security true output precision inputBits ho
  have hd := (BinaryProfileTables.diffuse_bounds security output precision inputBits ho).1
  have bsize : BinaryProposalMetadata.sizeBound security ≤ (leafHeightPolynomial precision inputBits).eval security := by
    simp only [leafHeightPolynomial, Polynomial.eval_add, Polynomial.eval_one, BinaryProposalMetadata.sizePolynomial_eval]
    omega
  have bact : (BinaryActivationProgram.currentHeightPolynomial precision).eval security ≤
      (leafHeightPolynomial precision inputBits).eval security := by
    simp only [leafHeightPolynomial, Polynomial.eval_add, Polynomial.eval_one]
    omega
  have bbody : (BinaryBodyProgram.currentHeightPolynomial precision inputBits).eval security ≤
      (leafHeightPolynomial precision inputBits).eval security := by
    simp only [leafHeightPolynomial, Polynomial.eval_add, Polynomial.eval_one]
    omega
  have bdiff : (BinaryProfileTables.diffuseHeightPolynomial precision inputBits).eval security ≤
      (leafHeightPolynomial precision inputBits).eval security := by
    simp only [leafHeightPolynomial, Polynomial.eval_add, Polynomial.eval_one]
    omega
  constructor
  · intro leaf
    cases leaf with
    | colors => exact hs.1.mono bsize
    | legs => exact hs.2.1.mono bsize
    | population => exact hs.2.2.mono bsize
    | activation => exact ha.mono bact
    | bodyZero => exact hz.mono bbody
    | bodyOne => exact ho'.mono bbody
    | diffuse => exact hd.mono bdiff
  · have wm := BinaryProposalMetadata.current_work security
    rw [← BinaryProposalMetadata.currentWorkPolynomial_eval security] at wm
    have wa := BinaryActivationProgram.current_polynomial_work precision security
    have wz := BinaryBodyProgram.current_polynomial_work security false output precision inputBits ho
    have wo := BinaryBodyProgram.current_polynomial_work security true output precision inputBits ho
    have wd := (BinaryProfileTables.diffuse_bounds security output precision inputBits ho).2
    change sizes.work+activation.work+zero.work+one.work+diffuse.work+5 ≤ _
    dsimp only [sizes, activation, zero, one, diffuse]
    simp only [cacheWorkPolynomial, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_ofNat]
    omega

theorem current_bounds (security : ℕ) (output : List Bool) (precision inputBits : Polynomial ℕ)
    (ho : output.length ≤ inputBits.eval security) :
    HeightBound (current security (precision.eval security) output).data.decode
      ((currentHeightPolynomial precision inputBits).eval security) ∧
    (current security (precision.eval security) output).work ≤ (currentWorkPolynomial precision inputBits).eval security := by
  let data := cache security (precision.eval security) output
  let height := (leafHeightPolynomial precision inputBits).eval security
  have hb := cache_bounds security output precision inputBits ho
  have hh (leaf : Leaf) : HeightBound (data.read leaf).value.decode height := by
    rw [Cache.read, RationalBits.copy_value]
    exact hb.1 leaf
  have hw (leaf : Leaf) : (data.read leaf).work ≤ 4*height+9 := by
    have hc := RationalBits.copy_work (data.entry leaf) height (hb.1 leaf)
    change (RationalBits.copy (data.entry leaf)).work+1 ≤ _
    omega
  have outputHeight := expression.run_height (fun leaf => (data.read leaf).value.decode) (fun _ => height) hh
  have totalHeight := expression.heightBudget_le (fun _ => height) (height+4)
    (fun _ => Nat.le_add_right _ _) (ScalarProgram.literalsBounded_mono expression_literals.literalsBounded (Nat.le_add_left _ _))
  have compiledWork := expression.compileBinaryRun_polynomial_work data.read security
    (Polynomial.C expression.nodes) 2 (leafHeightPolynomial precision inputBits) (4*leafHeightPolynomial precision inputBits+9)
    (by simp only [Polynomial.eval_C]; exact le_rfl)
    (by simpa only [Polynomial.eval_ofNat] using expression_literals)
    (by intro leaf; simpa only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_ofNat] using hw leaf) hh
  constructor
  · change HeightBound (expression.compileBinaryRun data.read).value.decode _
    rw [ScalarProgram.compileBinaryRun_value]
    apply outputHeight.mono
    apply totalHeight.trans_eq
    simp only [currentHeightPolynomial, Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_ofNat]
    change expression.nodes*(height+4+1)=expression.nodes*(height+5)
    congr 1
  · change data.work+(expression.compileBinaryRun data.read).work+2 ≤ _
    simp only [currentWorkPolynomial, Polynomial.eval_add, Polynomial.eval_ofNat]
    exact Nat.add_le_add_right (Nat.add_le_add hb.2 compiledWork) 2

end
end CurrentAFT.BinaryPrimaryRaw
