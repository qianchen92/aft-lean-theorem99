import CurrentAFT.CurrentFlagCompletionProgram
import CurrentAFT.CurrentPublicAffineSample
import AFT.FiniteConditionProgram

/-!
# Independent complete charts from a stored public input vector

Every core input is read by the sequential vector reader.  The leg count
is generated by a checked counter program.  `inputsOfCore` is the exact
mathematical decoder interface for the separately generated public core.
-/

namespace CurrentAFT.CurrentChartsDraw

open AFT AFT.BoundaryCalibration AFT.BinaryArithmetic AFT.RationalRejectionProgram
open CurrentAffineData ActualPublicCharge CurrentFlagJointDraw
open scoped BigOperators
set_option maxHeartbeats 500000
attribute [local irreducible] Parameters.legCount CurrentFlagCompletionProgram.draw

abbrev Input (security : ℕ) := AffineFlagCalibration.Palette security × ActualPublicLegCharge.PublicSeed security
abbrev InputVector (security : ℕ) := Vector (Input security) (Parameters.legCount security)
abbrev Tapes (security drawBits : ℕ) := Fin (Parameters.legCount security) → Tape (Parameters.modulus security) drawBits

def defaultInput (security : ℕ) : Input security :=
  (⟨0, (Parameters.modulus_spec security).2.pos⟩,
    ⟨false, false, ⟨0, InwardAnchor.anchorWidth_pos security⟩,
      (GaussianSource.windowZero (DiffuseProfiles.edgeCutoff security), GaussianSource.windowZero (DiffuseProfiles.edgeCutoff security))⟩)

def drawStored (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ)
    (word : Tapes security drawBits) : CountedValue (Vector (Bool × Chart (ZMod (Parameters.modulus security))) (Parameters.legCount security)) :=
  let base := addCounter security 2
  let count := powerCounter base.count 128
  have hcount : count.count = Parameters.legCount security := by
    rw [powerCounter_value, addCounter_value, Parameters.legCount_eq, Parameters.base]
  let charts := storeData count.count (fun index =>
    let leg := index.cast hcount
    let input := readVector (defaultInput security) inputs leg
    let result := CurrentFlagCompletionProgram.draw security input.value.1 input.value.2 precisionBits drawBits (word leg)
    (⟨result.value, input.work + result.work + 2⟩ : CountedValue (Bool × Chart (ZMod (Parameters.modulus security)))))
  ⟨charts.value.cast hcount, base.work + count.work + charts.work + 3⟩


/-- The public semantic function is the decoder of the retained chart array. -/
def draw (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ)
    (word : Tapes security drawBits) : CountedValue (Charts security) :=
  let stored := drawStored security inputs precisionBits drawBits word
  ⟨stored.value.get, stored.work⟩

theorem draw_stored_value (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ)
    (word : Tapes security drawBits) :
    (draw security inputs precisionBits drawBits word).value =
      (drawStored security inputs precisionBits drawBits word).value.get := rfl

theorem draw_work_eq (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ)
    (word : Tapes security drawBits) :
    (draw security inputs precisionBits drawBits word).work =
      (drawStored security inputs precisionBits drawBits word).work := rfl

theorem draw_value (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ)
    (word : Tapes security drawBits) (leg : Fin (Parameters.legCount security)) :
    (draw security inputs precisionBits drawBits word).value leg =
      (CurrentFlagCompletionProgram.draw security (inputs.get leg).1 (inputs.get leg).2
        precisionBits drawBits (word leg)).value := by
  simp only [draw, drawStored, Vector.get_cast, storeData_get, readVector_value, Fin.cast_cast, Fin.cast_eq_self]

attribute [local irreducible] draw

noncomputable section
open scoped Classical

def inputsOfCore (security : ℕ) (core : Core security) : InputVector security :=
  Vector.ofFn (fun leg => ((core.controls (.inl leg)).1, (core.legs leg).1))

def tapeLaw (security drawBits : ℕ) : FiniteDist (Tapes security drawBits) :=
  FiniteDist.independent (fun _ : Fin (Parameters.legCount security) =>
    CurrentFlagJointDraw.tapeLaw (Parameters.modulus security) drawBits)

theorem draw_law (security : ℕ) (inputs : InputVector security) (precisionBits drawBits : ℕ) :
    (tapeLaw security drawBits).map (fun word => (draw security inputs precisionBits drawBits word).value) =
      FiniteDist.independent (fun leg => (CurrentFlagJointDraw.tapeLaw (Parameters.modulus security) drawBits).map
        (fun word => (CurrentFlagCompletionProgram.draw security (inputs.get leg).1 (inputs.get leg).2 precisionBits drawBits word).value)) := by
  have hv : (fun word => (draw security inputs precisionBits drawBits word).value) =
      (fun word leg => (CurrentFlagCompletionProgram.draw security (inputs.get leg).1 (inputs.get leg).2
        precisionBits drawBits (word leg)).value) := by
    funext word leg
    exact draw_value security inputs precisionBits drawBits word leg
  rw [hv]
  exact FiniteConditionProgram.independent_decode
    (Index := Fin (Parameters.legCount security)) (Random := Tape (Parameters.modulus security) drawBits)
    (State := Bool × Chart (ZMod (Parameters.modulus security)))
    (fun _ => CurrentFlagJointDraw.tapeLaw (Parameters.modulus security) drawBits)
    (fun leg word => (CurrentFlagCompletionProgram.draw security (inputs.get leg).1 (inputs.get leg).2
      precisionBits drawBits word).value)

theorem core_draw_l1 (security : ℕ) (core : Core security) (precisionBits drawBits : ℕ) (hprecision : 1 ≤ precisionBits) :
    (∑ charts, |((tapeLaw security drawBits).map
      (fun word => (draw security (inputsOfCore security core) precisionBits drawBits word).value)).weight charts -
        (CurrentPublicAffineSample.chartsLaw security core).weight charts|) ≤
      (Parameters.legCount security : ℝ) * (1 / (2 : ℝ) ^ drawBits + 4 * (1 / (2 : ℝ) ^ precisionBits)) := by
  rw [draw_law]
  apply (FiniteDist.l1_independent_fin_le (Parameters.legCount security) _ _).trans
  have hsum := Finset.sum_le_sum (s := Finset.univ) (fun leg _ =>
    CurrentFlagCompletionProgram.draw_l1 security ((core.controls (.inl leg)).1) ((core.legs leg).1)
      precisionBits drawBits hprecision)
  simpa only [inputsOfCore, Vector.get_ofFn, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    CurrentPublicAffineSample.chartsLaw] using hsum

end
end CurrentAFT.CurrentChartsDraw
