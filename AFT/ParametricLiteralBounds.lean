import AFT.ParametricScalarInvariants
import AFT.ParametricOrderedOperations

/-! Literal values are bounded in magnitude as integers, so runtime-dependent
literals can be generated by counted integer loops, rather than stored by an
existential encoding theorem. -/
namespace AFT.RationalNumerics

def RationalLiteralBound (value : ℚ) (bound : ℕ) : Prop :=
  value.num.natAbs≤bound ∧ value.den≤bound

namespace RationalLiteralBound

theorem mono {value : ℚ} {first second : ℕ} (h : RationalLiteralBound value first) (hle : first≤second) :
    RationalLiteralBound value second := ⟨h.1.trans hle,h.2.trans hle⟩

theorem nat (value : ℕ) {bound : ℕ} (hv : value≤bound) (hb : 1≤bound) : RationalLiteralBound (value:ℚ) bound := by
  simpa [RationalLiteralBound] using And.intro hv hb

theorem one {bound : ℕ} (hb : 1≤bound) : RationalLiteralBound 1 bound := by simpa using nat 1 hb hb

theorem zero {bound : ℕ} (hb : 1≤bound) : RationalLiteralBound 0 bound := by simpa using nat 0 (Nat.zero_le _) hb

theorem neg {value : ℚ} {bound : ℕ} (h : RationalLiteralBound value bound) : RationalLiteralBound (-value) bound := by
  simpa only [RationalLiteralBound,Rat.neg_num,Int.natAbs_neg,Rat.neg_den] using h

theorem inv {value : ℚ} {bound : ℕ} (h : RationalLiteralBound value bound) : RationalLiteralBound value⁻¹ bound := by
  have hb : 1≤bound := (Nat.one_le_iff_ne_zero.mpr value.den_pos.ne').trans h.2
  by_cases hz : value=0
  · subst value
    simpa using zero hb
  constructor
  · simp only [Rat.num_inv,Int.natAbs_mul,Int.natAbs_natCast]
    have hsign : value.num.sign.natAbs=1 := by
      rcases lt_or_gt_of_ne (Rat.num_ne_zero.mpr hz) with hn|hn
      · simp [Int.sign_eq_neg_one_of_neg hn]
      · simp [Int.sign_eq_one_of_pos hn]
    simpa only [hsign,one_mul,mul_one] using h.2
  · simpa only [Rat.den_inv_of_ne_zero hz] using h.1

theorem fraction (numerator : ℤ) (denominator : ℕ) (hd : 0<denominator) :
    ((numerator:ℚ)/(denominator:ℚ)).num.natAbs≤numerator.natAbs ∧
      ((numerator:ℚ)/(denominator:ℚ)).den≤denominator := by
  have hn : (Rat.divInt numerator denominator).num.natAbs≤numerator.natAbs := by
    by_cases hz : numerator=0
    · simp [hz]
    · exact Nat.le_of_dvd (Int.natAbs_pos.mpr hz)
        (Int.natAbs_dvd_natAbs.mpr (Rat.num_dvd numerator (by exact_mod_cast hd.ne')))
  have hh : (Rat.divInt numerator denominator).den≤denominator :=
    Nat.le_of_dvd hd (by exact_mod_cast Rat.den_dvd numerator (denominator:ℤ))
  simpa only [Rat.divInt_eq_div,Int.cast_natCast] using And.intro hn hh

theorem nat_div (numerator denominator : ℕ) {bound : ℕ} (hn : numerator≤bound)
    (hd : denominator≤bound) (hb : 1≤bound) : RationalLiteralBound ((numerator:ℚ)/denominator) bound := by
  by_cases hz : denominator=0
  · subst denominator
    simpa using zero hb
  have hh := fraction (numerator:ℤ) denominator (Nat.pos_of_ne_zero hz)
  exact ⟨(by simpa using hh.1.trans (by simpa using hn)),hh.2.trans hd⟩

theorem neg_one_pow (count : ℕ) {bound : ℕ} (hb : 1≤bound) : RationalLiteralBound ((-1:ℚ)^count) bound := by
  rcases neg_one_pow_eq_or ℚ count with h|h
  · rw [h];exact one hb
  · rw [h];exact (one hb).neg

theorem signed_reciprocal (count : ℕ) {bound : ℕ} (hc : count+1≤bound) :
    RationalLiteralBound ((-1:ℚ)^count/(count+1)) bound := by
  have hh := (nat (count+1) hc (by omega)).inv
  rcases neg_one_pow_eq_or ℚ count with h|h
  · simpa only [h,one_div,Nat.cast_add,Nat.cast_one] using hh
  · simpa only [h,neg_div,one_div,Nat.cast_add,Nat.cast_one] using hh.neg

end RationalLiteralBound

namespace ScalarProgram
variable {Scalar : Type*}

def LiteralBound (bound : ℕ) : ScalarProgram Scalar → Prop
  | .rational value => RationalLiteralBound value bound
  | .atom _ => True
  | .add first second | .multiply first second => first.LiteralBound bound ∧ second.LiteralBound bound
  | .negate term | .inverse term => term.LiteralBound bound

theorem LiteralBound.mono {program : ScalarProgram Scalar} {first second : ℕ}
    (h : program.LiteralBound first) (hle : first≤second) : program.LiteralBound second := by
  induction program with
  | rational value => exact RationalLiteralBound.mono h hle
  | atom code => trivial
  | add first second hf hs | multiply first second hf hs => exact ⟨hf h.1,hs h.2⟩
  | negate term ih | inverse term ih => exact ih h
end ScalarProgram

namespace ParametricSeedTable
variable {Scalar Code Other : Type*}

def LiteralBound (bound : ℕ) (table : ParametricSeedTable Scalar Code) : Prop :=
  ∀ term∈table,term.coefficient.LiteralBound bound

theorem LiteralBound.mono {table : ParametricSeedTable Scalar Code} {first second : ℕ}
    (h : table.LiteralBound first) (hle : first≤second) : table.LiteralBound second :=
  fun term ht => (h term ht).mono hle

theorem LiteralBound.nil (bound : ℕ) : ParametricSeedTable.LiteralBound bound ([] : ParametricSeedTable Scalar Code) := by simp [LiteralBound]

theorem LiteralBound.one {bound : ℕ} (hb : 1≤bound) : (ParametricSeedTable.one : ParametricSeedTable Scalar Code).LiteralBound bound := by
  intro term ht
  simp only [ParametricSeedTable.one,List.mem_singleton] at ht
  subst term
  exact RationalLiteralBound.one hb

theorem LiteralBound.seed {bound : ℕ} (hb : 1≤bound) (code : Code) :
    (ParametricSeedTable.seed (Scalar:=Scalar) code).LiteralBound bound := by
  intro term ht
  simp only [ParametricSeedTable.seed,List.mem_singleton] at ht
  subst term
  exact RationalLiteralBound.one hb

theorem LiteralBound.constant {bound : ℕ} {scalar : ScalarProgram Scalar} (h : scalar.LiteralBound bound) :
    (ParametricSeedTable.constant (Code:=Code) scalar).LiteralBound bound := by
  intro term ht
  simp only [ParametricSeedTable.constant,List.mem_singleton] at ht
  subst term
  exact h

theorem LiteralBound.append {bound : ℕ} {first second : ParametricSeedTable Scalar Code}
    (hf : first.LiteralBound bound) (hs : second.LiteralBound bound) : (first++second).LiteralBound bound := by
  intro term ht
  rcases List.mem_append.mp ht with ht|ht
  · exact hf term ht
  · exact hs term ht

theorem LiteralBound.scale {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (scalar : ScalarProgram Scalar) (hs : scalar.LiteralBound bound) :
    (table.scale scalar).LiteralBound bound := by
  intro term ht
  obtain ⟨old,ho,rfl⟩ := List.mem_map.mp ht
  exact ⟨hs,h old ho⟩

theorem LiteralBound.rename {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (rename : Code→Other) : (table.rename rename).LiteralBound bound := by
  intro term ht
  obtain ⟨old,ho,rfl⟩ := List.mem_map.mp ht
  exact h old ho

theorem LiteralBound.multiply {bound : ℕ} {first second : ParametricSeedTable Scalar Code}
    (hf : first.LiteralBound bound) (hs : second.LiteralBound bound) : (first.multiply second).LiteralBound bound := by
  intro term ht
  obtain ⟨left,hl,ht⟩ := List.mem_flatMap.mp ht
  obtain ⟨right,hr,rfl⟩ := List.mem_map.mp ht
  exact ⟨hf left hl,hs right hr⟩

theorem LiteralBound.power {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (hb : 1≤bound) (count : ℕ) : (table.power count).LiteralBound bound := by
  induction count with
  | zero => exact .one hb
  | succ count ih => exact ih.multiply h

theorem LiteralBound.truncate {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (order : Code→ℕ) (cutoff : ℕ) : (table.truncate order cutoff).LiteralBound bound :=
  fun term ht => h term (List.mem_filter.mp ht).1

theorem LiteralBound.exponential {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (cutoff : ℕ) (hc : cutoff.factorial≤bound) :
    (table.exponential cutoff).LiteralBound bound := by
  have hb : 1≤bound := (Nat.factorial_pos cutoff).trans_le hc
  intro term ht
  obtain ⟨count,hcount,ht⟩ := List.mem_flatMap.mp ht
  have hk : count≤cutoff := by have := List.mem_range.mp hcount;omega
  exact ((h.power hb count).scale (.rational ((count.factorial : ℚ)⁻¹)) ((RationalLiteralBound.nat _
    ((Nat.factorial_le hk).trans hc) hb).inv)) term ht

theorem LiteralBound.logarithm {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (cutoff : ℕ) (hb : 1≤bound) (hc : cutoff≤bound) :
    (table.logarithm cutoff).LiteralBound bound := by
  intro term ht
  obtain ⟨count,hcount,ht⟩ := List.mem_flatMap.mp ht
  have hk : count+1≤bound := (List.mem_range.mp hcount).trans_le hc
  exact ((h.power hb (count+1)).scale (.rational ((-1:ℚ)^count/(count+1))) (RationalLiteralBound.signed_reciprocal count hk)) term ht

theorem LiteralBound.finiteCorrection {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (cutoff : ℕ) (hb : 1≤bound) :
    (table.finiteCorrection cutoff).LiteralBound bound := by
  intro term ht
  obtain ⟨count,_,ht⟩ := List.mem_flatMap.mp ht
  exact ((h.power hb count).scale (.rational ((-1:ℚ)^count)) (RationalLiteralBound.neg_one_pow count hb)) term ht

theorem LiteralBound.flatten {bound : ℕ} {tables : List (ParametricSeedTable Scalar Code)}
    (h : ∀ table∈tables,table.LiteralBound bound) : ParametricSeedTable.LiteralBound bound tables.flatten := by
  intro term ht
  obtain ⟨table,hm,ht⟩ := List.mem_flatten.mp ht
  exact h table hm term ht

theorem LiteralBound.sum {Index : Type*} {bound : ℕ} (indices : List Index)
    (table : Index→ParametricSeedTable Scalar Code) (h : ∀ index∈indices,(table index).LiteralBound bound) :
    ParametricSeedTable.LiteralBound bound (indices.flatMap table) := by
  intro term ht
  obtain ⟨index,hi,ht⟩ := List.mem_flatMap.mp ht
  exact h index hi term ht

theorem LiteralBound.foldMultiply {bound : ℕ} (tables : List (ParametricSeedTable Scalar Code))
    (h : ∀ table∈tables,table.LiteralBound bound) (initial : ParametricSeedTable Scalar Code)
    (hi : initial.LiteralBound bound) : LiteralBound bound (tables.foldl ParametricSeedTable.multiply initial) := by
  induction tables generalizing initial with
  | nil => exact hi
  | cons table rest ih =>
    exact ih (fun entry he => h entry (List.mem_cons_of_mem _ he)) _ (hi.multiply (h table (by simp)))

theorem LiteralBound.substitute {bound : ℕ} {table : ParametricSeedTable Scalar Code}
    (h : table.LiteralBound bound) (hb : 1≤bound) (images : Code→ParametricSeedTable Scalar Other)
    (hi : ∀ code,(images code).LiteralBound bound) : (table.substitute images).LiteralBound bound := by
  intro term ht
  obtain ⟨original,ho,ht⟩ := List.mem_flatMap.mp ht
  have hh := LiteralBound.foldMultiply (original.factors.map images)
    (by intro entry he;obtain ⟨code,_,rfl⟩:=List.mem_map.mp he;exact hi code)
    ParametricSeedTable.one (LiteralBound.one hb)
  exact (hh.scale original.coefficient (h original ho)) term ht

end ParametricSeedTable
end AFT.RationalNumerics
